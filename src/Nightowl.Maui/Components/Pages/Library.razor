@page "/library"
@inject IBookService BookService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<div class="mb-6">
    <div class="d-flex align-center justify-space-between mb-4 flex-wrap gap-2">
        <div>
            <MudText Typo="Typo.h4" Style="font-weight: 700; letter-spacing: -0.5px;">My Library</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Explore, organize, and manage your book collection.</MudText>
        </div>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.Add" 
                   Class="rounded-pill text-none"
                   OnClick="OpenAddDialog">
            Add New Book
        </MudButton>
    </div>

    <!-- Search and Filters Bar -->
    <MudPaper Class="pa-3 mb-4 rounded-lg" Elevation="1">
        <div class="d-flex gap-3 align-center flex-wrap">
            <div style="flex: 1; min-width: 220px;">
                <MudTextField @bind-Value="_searchTerm" 
                              Placeholder="Search by title, author, or ISBN..." 
                              Variant="Variant.Outlined" 
                              Margin="Margin.Dense" 
                              Adornment="Adornment.Start" 
                              AdornmentIcon="@Icons.Material.Filled.Search" 
                              Clearable="true" 
                              Immediate="true"
                              OnKeyUp="@HandleSearch" />
            </div>

            <MudToggleGroup T="string" @bind-Value="_selectedTab" SelectionMode="SelectionMode.SingleSelection" Color="Color.Primary">
                <MudToggleItem Value="@("All")" Text="All" />
                <MudToggleItem Value="@("Reading")" Text="Reading" />
                <MudToggleItem Value="@("WantToRead")" Text="Want to Read" />
                <MudToggleItem Value="@("Completed")" Text="Finished" />
            </MudToggleGroup>
        </div>
    </MudPaper>

    @if (_isLoading)
    {
        <div class="d-flex justify-center py-12">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else if (_filteredBooks.Count == 0)
    {
        <MudPaper Class="pa-8 d-flex flex-column align-center justify-center text-center rounded-lg" Elevation="0" Outlined="true" Style="border-style: dashed;">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Secondary" Class="mb-3" />
            <MudText Typo="Typo.h6">No books found</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                @(string.IsNullOrWhiteSpace(_searchTerm) ? "Your library has no books in this category." : "No books match your search query.")
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Class="rounded-pill text-none" OnClick="OpenAddDialog">
                Add a Book
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudGrid>
            @foreach (var book in _filteredBooks)
            {
                <MudItem xs="12" sm="6" md="4" lg="3" @key="book.Id">
                    <MudCard Elevation="2" Class="rounded-lg h-100 d-flex flex-column" Style="overflow: hidden; transition: transform 0.2s;" UserAttributes="@(new Dictionary<string, object> { { "style", "cursor: pointer;" } })">
                        <div class="pa-3 d-flex flex-column flex-grow-1" @onclick="() => NavigateToBook(book.Id)">
                            <div class="d-flex justify-space-between align-start mb-2">
                                <MudChip T="string" Variant="Variant.Filled" Color="@GetStatusColor(book.Status)" Size="Size.Small" Class="text-none">
                                    @GetStatusLabel(book.Status)
                                </MudChip>

                                @if (book.Rating.HasValue)
                                {
                                    <div class="d-flex align-center">
                                        <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" Size="Size.Small" />
                                        <MudText Typo="Typo.caption" Class="ml-1" Style="font-weight: 700;">@book.Rating.Value</MudText>
                                    </div>
                                }
                            </div>

                            <div class="d-flex justify-center my-2">
                                @if (!string.IsNullOrWhiteSpace(book.CoverUrl))
                                {
                                    <img src="@book.CoverUrl" alt="Cover" style="width: 100px; height: 150px; object-fit: cover; border-radius: 8px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.3);" />
                                }
                                else
                                {
                                    <div style="width: 100px; height: 150px; background: #1e293b; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #64748b;">
                                        <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Large" />
                                    </div>
                                }
                            </div>

                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700; text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@book.Title">
                                @book.Title
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@book.Authors">
                                @book.Authors
                            </MudText>

                            <div class="mt-auto pt-3">
                                <div class="d-flex justify-space-between align-center mb-1">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Progress</MudText>
                                    <MudText Typo="Typo.caption" Style="font-weight: 600;">@book.CurrentPage / @book.PageCount</MudText>
                                </div>
                                <MudProgressLinear Color="@GetStatusColor(book.Status)" Value="@book.ProgressPercentage" Rounded="true" Size="Size.Small" />
                            </div>
                        </div>

                        <MudDivider />

                        <MudCardActions Class="pa-2 px-3 d-flex justify-space-between">
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.EditNote" OnClick="() => OpenProgressDialog(book)">
                                Update
                            </MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small" OnClick="() => NavigateToBook(book.Id)">
                                Details
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</div>

@code {
    private List<BookSummaryDto> _allBooks = new();
    private List<BookSummaryDto> _filteredBooks = new();
    private string _searchTerm = string.Empty;
    private string _selectedTab = "All";
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadBooksAsync();
    }

    private async Task LoadBooksAsync()
    {
        _isLoading = true;
        try
        {
            var books = await BookService.GetAllBooksAsync();
            _allBooks = books.ToList();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load library: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void HandleSearch()
    {
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var query = _allBooks.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim().ToLowerInvariant();
            query = query.Where(b => 
                b.Title.ToLowerInvariant().Contains(term) ||
                b.Authors.ToLowerInvariant().Contains(term) ||
                b.Isbn.Contains(term));
        }

        query = _selectedTab switch
        {
            "Reading" => query.Where(b => b.Status == ReadingStatus.CurrentlyReading),
            "WantToRead" => query.Where(b => b.Status == ReadingStatus.WantToRead),
            "Completed" => query.Where(b => b.Status == ReadingStatus.Completed),
            _ => query
        };

        _filteredBooks = query.ToList();
        StateHasChanged();
    }

    private void NavigateToBook(Guid id)
    {
        NavigationManager.NavigateTo($"book/{id}");
    }

    private async Task OpenAddDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<Nightowl.Maui.Components.Dialogs.AddBookDialog>("Catalog a Book", options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            await LoadBooksAsync();
        }
    }

    private async Task OpenProgressDialog(BookSummaryDto book)
    {
        var parameters = new DialogParameters<Nightowl.Maui.Components.Dialogs.UpdateProgressDialog>
        {
            { x => x.BookId, book.Id },
            { x => x.BookTitle, book.Title },
            { x => x.CurrentPage, book.CurrentPage },
            { x => x.TotalPages, book.PageCount }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        var dialog = await DialogService.ShowAsync<Nightowl.Maui.Components.Dialogs.UpdateProgressDialog>("Log Reading Session", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            await LoadBooksAsync();
        }
    }

    private static Color GetStatusColor(ReadingStatus status) => status switch
    {
        ReadingStatus.CurrentlyReading => Color.Primary,
        ReadingStatus.Completed => Color.Success,
        ReadingStatus.WantToRead => Color.Info,
        ReadingStatus.OnHold => Color.Warning,
        ReadingStatus.Dropped => Color.Error,
        _ => Color.Default
    };

    private static string GetStatusLabel(ReadingStatus status) => status switch
    {
        ReadingStatus.CurrentlyReading => "Reading",
        ReadingStatus.Completed => "Completed",
        ReadingStatus.WantToRead => "Want to Read",
        ReadingStatus.OnHold => "On Hold",
        ReadingStatus.Dropped => "Dropped",
        _ => status.ToString()
    };
}
