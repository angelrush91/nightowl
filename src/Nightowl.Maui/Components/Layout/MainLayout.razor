@inherits LayoutComponentBase
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@using Nightowl.Maui.Theme
@using Nightowl.Maui.Components.Dialogs

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Small" CloseButton="false" BackdropClick="true" Position="DialogPosition.BottomCenter" />
<MudSnackbarProvider />

<MudLayout Class="d-flex flex-column h-100">
    <!-- Android Native-Style Top App Bar -->
    <MudAppBar Elevation="0" Dense="true" Class="nightowl-appbar px-3">
        @if (IsDetailPage)
        {
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" 
                           Color="Color.Inherit" 
                           Edge="Edge.Start" 
                           OnClick="GoBack" />
        }
        else
        {
            <MudAvatar Color="Color.Primary" Size="Size.Small" Class="mr-2">🦉</MudAvatar>
        }

        <MudText Typo="Typo.subtitle1" Class="d-flex align-center" Style="font-family: 'Cinzel', serif; font-weight: 700; letter-spacing: 1.5px;">
            NIGHTOWL
        </MudText>

        <MudSpacer />

        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" 
                       Color="Color.Inherit" 
                       Size="Size.Small"
                       OnClick="@ToggleDarkMode" 
                       title="@(_isDarkMode ? "Light Mode" : "Dark Mode")" />
    </MudAppBar>

    <!-- Main Scrollable Content Area -->
    <MudMainContent Class="nightowl-content pt-3">
        @Body
    </MudMainContent>

    <!-- Floating Action Button: 1-Tap Barcode Scanner -->
    <MudFab Color="Color.Primary" 
            StartIcon="@Icons.Material.Filled.QrCodeScanner" 
            Label="Scan" 
            Size="Size.Medium" 
            Class="nightowl-fab rounded-pill text-none"
            OnClick="OpenAddBookDialog" />

    <!-- Android Bottom Navigation Bar -->
    <nav class="nightowl-bottom-nav">
        <div class="nightowl-nav-item @(IsActive("") ? "active" : "")" @onclick="@(() => NavigateTo(""))">
            <div class="nav-icon-pill">
                <MudIcon Icon="@(IsActive("") ? Icons.Material.Filled.Dashboard : Icons.Material.Outlined.Dashboard)" Size="Size.Medium" />
            </div>
            <span class="nav-label">Home</span>
        </div>

        <div class="nightowl-nav-item @(IsActive("library") ? "active" : "")" @onclick="@(() => NavigateTo("library"))">
            <div class="nav-icon-pill">
                <MudIcon Icon="@(IsActive("library") ? Icons.Material.Filled.AutoStories : Icons.Material.Outlined.AutoStories)" Size="Size.Medium" />
            </div>
            <span class="nav-label">Library</span>
        </div>

        <div class="nightowl-nav-item @(IsActive("stats") ? "active" : "")" @onclick="@(() => NavigateTo("stats"))">
            <div class="nav-icon-pill">
                <MudIcon Icon="@(IsActive("stats") ? Icons.Material.Filled.Analytics : Icons.Material.Outlined.Analytics)" Size="Size.Medium" />
            </div>
            <span class="nav-label">Stats</span>
        </div>
    </nav>
</MudLayout>

@code {
    private bool _isDarkMode = true;
    private readonly MudTheme _theme = NightowlTheme.CreateTheme();

    private bool IsDetailPage => NavigationManager.Uri.Contains("/book/");

    private bool IsActive(string route)
    {
        var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        if (string.IsNullOrEmpty(route))
        {
            return string.IsNullOrEmpty(relative) || relative == "/";
        }
        return relative.StartsWith(route, StringComparison.OrdinalIgnoreCase);
    }

    private void NavigateTo(string route)
    {
        NavigationManager.NavigateTo(route);
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("library");
    }

    private void ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
    }

    private async Task OpenAddBookDialog()
    {
        var options = new DialogOptions 
        { 
            CloseOnEscapeKey = true, 
            MaxWidth = MaxWidth.Small, 
            FullWidth = true,
            Position = DialogPosition.BottomCenter
        };
        var dialog = await DialogService.ShowAsync<AddBookDialog>("Catalog a Book", options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            Snackbar.Add("Book successfully cataloged in your library!", Severity.Success);
            // Refresh current page if needed
            StateHasChanged();
        }
    }
}
