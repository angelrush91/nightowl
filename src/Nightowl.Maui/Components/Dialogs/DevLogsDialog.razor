@using Nightowl.Infrastructure.Logging
@using Serilog.Events
@inject IDevLogService DevLogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IDisposable

<MudDialog Class="nightowl-dialog" Style="max-height: 90vh;">
    <TitleContent>
        <div class="d-flex align-center justify-space-between w-100 pr-2">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.Terminal" Color="Color.Primary" />
                <div>
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 700; line-height: 1.2;">
                        Developer Logs
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @FilteredLogs.Count / @_allLogs.Count entries
                    </MudText>
                </div>
            </div>

            <MudIconButton Icon="@Icons.Material.Filled.Close" 
                           Color="Color.Default" 
                           Size="Size.Small" 
                           OnClick="Close" />
        </div>
    </TitleContent>

    <DialogContent>
        <!-- Filter Controls -->
        <div class="d-flex flex-column gap-2 mb-3">
            <MudTextField @bind-Value="_searchQuery"
                          Placeholder="Search logs or category..." 
                          Variant="Variant.Outlined" 
                          Margin="Margin.Dense" 
                          Clearable="true"
                          Adornment="Adornment.Start" 
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true" />

            <div class="d-flex flex-wrap gap-1 align-center">
                <MudChip T="string"
                         Color="@(_selectedLevel == null ? Color.Primary : Color.Default)"
                         Variant="@(_selectedLevel == null ? Variant.Filled : Variant.Outlined)"
                         Size="Size.Small"
                         OnClick="@(() => SetLevelFilter(null))">
                    All
                </MudChip>
                <MudChip T="string"
                         Color="@(_selectedLevel == LogEventLevel.Debug ? Color.Secondary : Color.Default)"
                         Variant="@(_selectedLevel == LogEventLevel.Debug ? Variant.Filled : Variant.Outlined)"
                         Size="Size.Small"
                         OnClick="@(() => SetLevelFilter(LogEventLevel.Debug))">
                    Debug
                </MudChip>
                <MudChip T="string"
                         Color="@(_selectedLevel == LogEventLevel.Information ? Color.Info : Color.Default)"
                         Variant="@(_selectedLevel == LogEventLevel.Information ? Variant.Filled : Variant.Outlined)"
                         Size="Size.Small"
                         OnClick="@(() => SetLevelFilter(LogEventLevel.Information))">
                    Info
                </MudChip>
                <MudChip T="string"
                         Color="@(_selectedLevel == LogEventLevel.Warning ? Color.Warning : Color.Default)"
                         Variant="@(_selectedLevel == LogEventLevel.Warning ? Variant.Filled : Variant.Outlined)"
                         Size="Size.Small"
                         OnClick="@(() => SetLevelFilter(LogEventLevel.Warning))">
                    Warning
                </MudChip>
                <MudChip T="string"
                         Color="@(_selectedLevel == LogEventLevel.Error ? Color.Error : Color.Default)"
                         Variant="@(_selectedLevel == LogEventLevel.Error ? Variant.Filled : Variant.Outlined)"
                         Size="Size.Small"
                         OnClick="@(() => SetLevelFilter(LogEventLevel.Error))">
                    Error
                </MudChip>
            </div>
        </div>

        <!-- Log List -->
        <div class="log-container rounded-lg p-2" style="max-height: 50vh; overflow-y: auto; background: #0b0f19; border: 1px solid #1e293b; font-family: monospace;">
            @if (FilteredLogs.Count == 0)
            {
                <div class="d-flex flex-column align-center justify-center py-8 text-center text-slate-500">
                    <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Class="mb-1" />
                    <MudText Typo="Typo.caption">No logs match the current filter.</MudText>
                </div>
            }
            else
            {
                @foreach (var log in FilteredLogs)
                {
                    <div class="log-entry py-1 px-1 border-b border-slate-800" style="font-size: 0.72rem; line-height: 1.35;">
                        <div class="d-flex align-center gap-1.5 flex-wrap">
                            <span style="color: #64748b;">@log.Timestamp.ToString("HH:mm:ss.fff")</span>
                            <span class="px-1.5 py-0.5 rounded text-[10px] font-bold" style="@GetLevelBadgeStyle(log.Level)">
                                @log.Level.ToString().ToUpperInvariant()
                            </span>
                            @if (!string.IsNullOrWhiteSpace(log.SourceContext))
                            {
                                <span style="color: #38bdf8; font-weight: 600;">[@log.SourceContext]</span>
                            }
                        </div>
                        <div class="mt-0.5" style="color: #e2e8f0; word-break: break-word;">
                            @log.Message
                        </div>
                        @if (!string.IsNullOrWhiteSpace(log.Exception))
                        {
                            <pre class="mt-1 p-1.5 rounded" style="background: rgba(220, 38, 38, 0.15); color: #fca5a5; font-size: 0.65rem; white-space: pre-wrap; word-break: break-all; border: 1px solid rgba(220, 38, 38, 0.3);">
@log.Exception
                            </pre>
                        }
                    </div>
                }
            }
        </div>
    </DialogContent>

    <DialogActions>
        <div class="d-flex align-center justify-space-between w-100 px-2 py-1">
            <div class="d-flex gap-1">
                <MudButton Variant="Variant.Outlined" 
                           Color="Color.Default" 
                           Size="Size.Small" 
                           StartIcon="@Icons.Material.Filled.ContentCopy" 
                           Class="text-none"
                           OnClick="CopyLogsToClipboardAsync">
                    Copy
                </MudButton>

                <MudButton Variant="Variant.Outlined" 
                           Color="Color.Error" 
                           Size="Size.Small" 
                           StartIcon="@Icons.Material.Filled.DeleteSweep" 
                           Class="text-none"
                           OnClick="ClearLogs">
                    Clear
                </MudButton>
            </div>

            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       Size="Size.Small" 
                       Class="rounded-pill px-4 text-none" 
                       OnClick="Close">
                Close
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private string _searchQuery = string.Empty;
    private LogEventLevel? _selectedLevel;
    private List<LogEntryItem> _allLogs = new();

    protected override void OnInitialized()
    {
        RefreshLogs();
        DevLogService.OnLogAdded += HandleLogAdded;
    }

    private void HandleLogAdded(LogEntryItem item)
    {
        InvokeAsync(() =>
        {
            _allLogs.Insert(0, item);
            StateHasChanged();
        });
    }

    private void RefreshLogs()
    {
        _allLogs = DevLogService.GetLogs().ToList();
    }

    private void SetLevelFilter(LogEventLevel? level)
    {
        _selectedLevel = level;
    }

    private List<LogEntryItem> FilteredLogs
    {
        get
        {
            IEnumerable<LogEntryItem> query = _allLogs;

            if (_selectedLevel.HasValue)
            {
                query = query.Where(l => l.Level >= _selectedLevel.Value);
            }

            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var term = _searchQuery.Trim();
                query = query.Where(l =>
                    l.Message.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (l.SourceContext != null && l.SourceContext.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                    (l.Exception != null && l.Exception.Contains(term, StringComparison.OrdinalIgnoreCase))
                );
            }

            return query.ToList();
        }
    }

    private static string GetLevelBadgeStyle(LogEventLevel level) => level switch
    {
        LogEventLevel.Verbose => "background: #334155; color: #94a3b8;",
        LogEventLevel.Debug => "background: #1e293b; color: #cbd5e1;",
        LogEventLevel.Information => "background: #0369a1; color: #e0f2fe;",
        LogEventLevel.Warning => "background: #b45309; color: #fef3c7;",
        LogEventLevel.Error or LogEventLevel.Fatal => "background: #991b1b; color: #fee2e2;",
        _ => "background: #334155; color: #cbd5e1;"
    };

    private async Task CopyLogsToClipboardAsync()
    {
        var text = DevLogService.ExportLogsAsText();
        await Clipboard.Default.SetTextAsync(text);
        Snackbar.Add($"Copied {_allLogs.Count} logs to clipboard!", Severity.Success);
    }

    private void ClearLogs()
    {
        DevLogService.ClearLogs();
        _allLogs.Clear();
        Snackbar.Add("Logs cleared", Severity.Info);
        StateHasChanged();
    }

    private void Close()
    {
        MudDialog.Close();
    }

    public void Dispose()
    {
        DevLogService.OnLogAdded -= HandleLogAdded;
    }
}
