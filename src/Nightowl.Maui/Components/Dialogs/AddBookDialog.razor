@using Nightowl.Domain.ValueObjects
@using Nightowl.Domain.Enums
@inject IBookService BookService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IAsyncDisposable

<MudDialog Class="nightowl-dialog">
    <DialogContent>
        @if (_previewMetadata == null)
        {
            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Centered="true" Class="px-1" @bind-ActivePanelIndex="_activeTab">
                <MudTabPanel Text="Scan Barcode" Icon="@Icons.Material.Filled.QrCodeScanner">
                    <div class="d-flex flex-column align-center justify-center pt-2 pb-1">
                        <div class="scanner-container">
                            <video id="scannerVideo" @ref="_videoRef" class="scanner-video" playsinline></video>
                            
                            @if (_isCameraStarting)
                            {
                                <div style="position: absolute; inset: 0; background: rgba(11, 15, 25, 0.85); display: flex; flex-direction: column; align-items: center; justify-content: center; color: white;">
                                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" Class="mb-2" />
                                    <MudText Typo="Typo.caption">Starting camera...</MudText>
                                </div>
                            }
                            else if (!_isCameraActive)
                            {
                                <div style="position: absolute; inset: 0; background: rgba(11, 15, 25, 0.9); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 1.5rem; text-align: center;">
                                    <MudIcon Icon="@Icons.Material.Filled.CameraAlt" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
                                    <MudText Typo="Typo.body2" Class="mb-1" Style="font-weight: 600;">Camera Ready</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                                        Tap below to activate camera and scan book barcodes.
                                    </MudText>
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Videocam" Class="rounded-pill px-4 text-none" OnClick="StartCameraAsync">
                                        Turn On Camera
                                    </MudButton>
                                </div>
                            }
                            else
                            {
                                <!-- Aiming reticle with animated laser line -->
                                <div class="scanner-overlay">
                                    <div class="scanner-laser"></div>
                                </div>

                                <!-- Flashlight / Torch toggle button -->
                                @if (_isTorchAvailable)
                                {
                                    <div style="position: absolute; top: 12px; right: 12px; z-index: 10;">
                                        <MudIconButton Icon="@(_isTorchOn ? Icons.Material.Filled.FlashOn : Icons.Material.Filled.FlashOff)" 
                                                       Color="@(_isTorchOn ? Color.Warning : Color.Inherit)"
                                                       Style="background: rgba(0,0,0,0.5); backdrop-filter: blur(4px);"
                                                       Size="Size.Small"
                                                       OnClick="ToggleTorchAsync" />
                                    </div>
                                }
                            }
                        </div>

                        <div class="d-flex align-center justify-space-between w-100 px-2 mt-3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-flex align-center gap-1">
                                <MudIcon Icon="@Icons.Material.Filled.CenterFocusStrong" Size="Size.Small" />
                                Align ISBN barcode in box
                            </MudText>

                            @if (_isCameraActive)
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.VideocamOff" Class="text-none" OnClick="StopCameraAsync">
                                    Stop Camera
                                </MudButton>
                            }
                        </div>
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="Type ISBN" Icon="@Icons.Material.Filled.Keyboard">
                    <div class="py-3 px-1">
                        <MudTextField @bind-Value="_isbnInput" 
                                      Label="ISBN-10 or ISBN-13" 
                                      Placeholder="e.g. 9780132350884" 
                                      Variant="Variant.Outlined" 
                                      Adornment="Adornment.Start" 
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Immediate="true"
                                      HelperText="@_isbnValidationMessage"
                                      HelperTextOnFocus="true"
                                      UserAttributes="@(new Dictionary<string, object> { { "inputmode", "numeric" }, { "pattern", "[0-9X-]*" } })"
                                      OnKeyDown="@HandleKeyDown" />

                        <div class="d-flex gap-2 mt-3">
                            <MudButton Variant="Variant.Outlined" 
                                       Color="Color.Default" 
                                       StartIcon="@Icons.Material.Filled.ContentPaste" 
                                       Class="rounded-pill text-none flex-grow-1" 
                                       OnClick="PasteFromClipboardAsync">
                                Paste ISBN
                            </MudButton>

                            <MudButton Variant="Variant.Filled" 
                                       Color="Color.Primary" 
                                       Class="rounded-pill text-none flex-grow-1" 
                                       Disabled="@(!_isIsbnValid || _isLoading)" 
                                       OnClick="LookupIsbnAsync">
                                @if (_isLoading)
                                {
                                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                    <span class="ms-2">Searching...</span>
                                }
                                else
                                {
                                    <span>Search Online</span>
                                }
                            </MudButton>
                        </div>
                    </div>
                </MudTabPanel>
            </MudTabs>
        }
        else
        {
            <!-- Book Preview & Confirmation -->
            <div class="pa-1">
                <div class="d-flex gap-3 mb-3">
                    @if (!string.IsNullOrWhiteSpace(_coverUrl))
                    {
                        <img src="@_coverUrl" alt="Cover" style="width: 84px; height: 126px; object-fit: cover; border-radius: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.3); flex-shrink: 0;" />
                    }
                    else
                    {
                        <div style="width: 84px; height: 126px; background: #1e293b; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #64748b; flex-shrink: 0;">
                            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Large" />
                        </div>
                    }

                    <div style="flex: 1; min-width: 0;">
                        <MudTextField @bind-Value="_title" Label="Title" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
                        <MudTextField @bind-Value="_authors" Label="Author(s)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </div>
                </div>

                <div class="d-flex gap-2 mb-3">
                    <MudNumericField @bind-Value="_pageCount" Label="Total Pages" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Style="flex: 1;" />
                    <MudTextField @bind-Value="_isbn" Label="ISBN" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true" Style="flex: 1;" />
                </div>

                <div class="d-flex gap-2 align-center mb-2">
                    <MudSelect @bind-Value="_status" Label="Reading Status" Variant="Variant.Outlined" Margin="Margin.Dense" Style="flex: 1;">
                        <MudSelectItem Value="ReadingStatus.WantToRead">Want to Read</MudSelectItem>
                        <MudSelectItem Value="ReadingStatus.CurrentlyReading">Currently Reading</MudSelectItem>
                        <MudSelectItem Value="ReadingStatus.Completed">Completed</MudSelectItem>
                        <MudSelectItem Value="ReadingStatus.OnHold">On Hold</MudSelectItem>
                    </MudSelect>

                    @if (_status == ReadingStatus.CurrentlyReading)
                    {
                        <MudNumericField @bind-Value="_initialPage" Label="Current Page" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="@_pageCount" Style="width: 120px;" />
                    }
                </div>
            </div>
        }
    </DialogContent>

    <DialogActions>
        @if (_previewMetadata != null)
        {
            <MudButton Variant="Variant.Text" Color="Color.Default" Class="text-none" OnClick="ResetLookup">Back</MudButton>
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="rounded-pill px-4 text-none" Disabled="_isSaving" OnClick="SaveBookAsync">
                @if (_isSaving)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <span class="ms-2">Saving...</span>
                }
                else
                {
                    <span>Save to Library</span>
                }
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" Color="Color.Default" Class="text-none" OnClick="Cancel">Close</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private ElementReference _videoRef;
    private DotNetObjectReference<AddBookDialog>? _dotNetRef;
    private int _activeTab = 0;
    private bool _isCameraActive = false;
    private bool _isCameraStarting = false;
    private bool _isTorchAvailable = false;
    private bool _isTorchOn = false;

    private string _isbnInput = string.Empty;
    private bool _isIsbnValid => Isbn.TryCreate(_isbnInput, out _);
    private string _isbnValidationMessage => string.IsNullOrWhiteSpace(_isbnInput) 
        ? "Enter a 10 or 13-digit ISBN" 
        : (_isIsbnValid ? "✓ Valid ISBN" : "✕ Invalid ISBN checksum");

    private bool _isLoading = false;
    private bool _isSaving = false;

    private IsbnBookMetadataDto? _previewMetadata;

    private string _title = string.Empty;
    private string _authors = string.Empty;
    private string _isbn = string.Empty;
    private int _pageCount = 0;
    private string? _subtitle;
    private string? _publisher;
    private string? _publishedDate;
    private string? _coverUrl;
    private string? _description;
    private ReadingStatus _status = ReadingStatus.WantToRead;
    private int _initialPage = 0;

    protected override void OnInitialized()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Auto-start camera when dialog opens for instant mobile scanning
            await Task.Delay(150);
            await StartCameraAsync();
        }
    }

    private async Task StartCameraAsync()
    {
        if (_isCameraActive || _isCameraStarting) return;

        _isCameraStarting = true;
        StateHasChanged();

        try
        {
            var status = await Permissions.CheckStatusAsync<Permissions.Camera>();
            if (status != PermissionStatus.Granted)
            {
                status = await Permissions.RequestAsync<Permissions.Camera>();
            }

            if (status != PermissionStatus.Granted)
            {
                _isCameraStarting = false;
                Snackbar.Add("Camera permission is required to scan barcodes.", Severity.Warning);
                return;
            }

            _isCameraActive = true;
            _isCameraStarting = false;
            StateHasChanged();

            var success = await JS.InvokeAsync<bool>("nightowlScanner.startScanner", _videoRef, _dotNetRef);
            if (success)
            {
                _isTorchAvailable = await JS.InvokeAsync<bool>("nightowlScanner.isTorchAvailable");
                StateHasChanged();
            }
            else
            {
                _isCameraActive = false;
                Snackbar.Add("Could not access camera. You can enter the ISBN manually.", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            _isCameraActive = false;
            _isCameraStarting = false;
            Snackbar.Add($"Camera error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isCameraStarting = false;
            StateHasChanged();
        }
    }

    private async Task ToggleTorchAsync()
    {
        _isTorchOn = !_isTorchOn;
        var success = await JS.InvokeAsync<bool>("nightowlScanner.toggleTorch", _isTorchOn);
        if (!success)
        {
            _isTorchOn = !_isTorchOn;
        }
    }

    private async Task StopCameraAsync()
    {
        try
        {
            _isCameraActive = false;
            _isTorchOn = false;
            await JS.InvokeVoidAsync("nightowlScanner.stopScanner");
        }
        catch {}
    }

    [JSInvokable]
    public async Task OnBarcodeDetected(string barcode)
    {
        await StopCameraAsync();
        _isbnInput = barcode;
        Snackbar.Add($"Barcode found: {barcode}", Severity.Success);
        await LookupIsbnAsync();
    }

    private async Task PasteFromClipboardAsync()
    {
        try
        {
            if (Clipboard.Default.HasText)
            {
                var text = await Clipboard.Default.GetTextAsync();
                if (!string.IsNullOrWhiteSpace(text))
                {
                    // Clean hyphens/spaces
                    _isbnInput = text.Replace("-", "").Replace(" ", "").Trim();
                    Snackbar.Add("Pasted from clipboard", Severity.Info);
                    if (_isIsbnValid)
                    {
                        await LookupIsbnAsync();
                    }
                }
            }
        }
        catch
        {
            Snackbar.Add("Could not read clipboard", Severity.Warning);
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && _isIsbnValid && !_isLoading)
        {
            await LookupIsbnAsync();
        }
    }

    private async Task LookupIsbnAsync()
    {
        if (!_isIsbnValid) return;

        _isLoading = true;
        StateHasChanged();

        try
        {
            var meta = await BookService.LookupIsbnAsync(_isbnInput);
            if (meta != null)
            {
                _previewMetadata = meta;
                _title = meta.Title;
                _authors = meta.Authors;
                _isbn = meta.Isbn;
                _pageCount = meta.PageCount;
                _subtitle = meta.Subtitle;
                _publisher = meta.Publisher;
                _publishedDate = meta.PublishDate;
                _coverUrl = meta.CoverUrl;
                _description = meta.Description;
            }
            else
            {
                var isbnObj = new Isbn(_isbnInput);
                _previewMetadata = new IsbnBookMetadataDto(
                    Title: "",
                    Subtitle: null,
                    Authors: "",
                    Isbn: isbnObj.Value,
                    PageCount: 0,
                    Publisher: null,
                    PublishDate: null,
                    CoverUrl: $"https://covers.openlibrary.org/b/isbn/{isbnObj.Value}-M.jpg",
                    Description: null
                );
                _isbn = isbnObj.Value;
                _coverUrl = _previewMetadata.CoverUrl;
                Snackbar.Add("No book metadata found online. You can enter details manually.", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lookup error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void ResetLookup()
    {
        _previewMetadata = null;
        _title = string.Empty;
        _authors = string.Empty;
        _pageCount = 0;
        _description = null;
    }

    private async Task SaveBookAsync()
    {
        if (string.IsNullOrWhiteSpace(_title))
        {
            Snackbar.Add("Please enter a book title.", Severity.Warning);
            return;
        }

        _isSaving = true;
        try
        {
            var createDto = new CreateBookDto(
                Title: _title,
                Authors: _authors,
                Isbn: _isbn,
                PageCount: _pageCount,
                Subtitle: _subtitle,
                Publisher: _publisher,
                PublishedDate: _publishedDate,
                CoverUrl: _coverUrl,
                Description: _description,
                Status: _status,
                InitialPage: _initialPage
            );

            await BookService.AddBookAsync(createDto);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    public async ValueTask DisposeAsync()
    {
        await StopCameraAsync();
        _dotNetRef?.Dispose();
    }
}
