@inject IBookService BookService
@inject ISnackbar Snackbar

<MudDialog Class="nightowl-dialog">
    <DialogContent>
        <div class="pa-1">
            <MudText Typo="Typo.subtitle1" Style="font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                @BookTitle
            </MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Total: @TotalPages pages</MudText>

            <div class="mt-3">
                <div class="d-flex justify-space-between align-center mb-1">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Reading Progress</MudText>
                    <MudText Typo="Typo.body2" Style="font-weight: 700;">
                        @_currentPage / @TotalPages (@ProgressPercentage.ToString("F0")%)
                    </MudText>
                </div>

                @if (TotalPages > 0)
                {
                    <MudSlider @bind-Value="_currentPage" Min="0" Max="@TotalPages" Color="Color.Primary" ValueLabel="true" Class="my-2" />
                }

                <!-- Quick Increment Chips (Thumb-Friendly) -->
                <div class="d-flex gap-2 flex-wrap my-3">
                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="() => AddPages(10)">+10p</MudChip>
                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="() => AddPages(25)">+25p</MudChip>
                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="() => AddPages(50)">+50p</MudChip>
                    @if (TotalPages > 0)
                    {
                        <MudChip T="string" Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" OnClick="MarkFinished">Finished! 🎉</MudChip>
                    }
                </div>

                <!-- Stepper Page Input -->
                <div class="d-flex gap-2 align-center mb-3">
                    <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline" 
                                   Color="Color.Primary" 
                                   OnClick="@(() => AddPages(-1))" 
                                   Disabled="@(_currentPage <= 0)" />
                    
                    <MudNumericField @bind-Value="_currentPage" 
                                     Label="Current Page" 
                                     Variant="Variant.Outlined" 
                                     Margin="Margin.Dense" 
                                     Min="0" 
                                     Max="@(TotalPages > 0 ? TotalPages : 99999)" 
                                     Class="flex-grow-1" />

                    <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline" 
                                   Color="Color.Primary" 
                                   OnClick="@(() => AddPages(1))" 
                                   Disabled="@(TotalPages > 0 && _currentPage >= TotalPages)" />
                </div>

                <MudTextField @bind-Value="_notes" 
                              Label="Session Notes (optional)" 
                              Placeholder="Any thoughts, quotes, or chapter notes..." 
                              Variant="Variant.Outlined" 
                              Lines="2" 
                              Margin="Margin.Dense" />
            </div>
        </div>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" Class="text-none" OnClick="Cancel">Cancel</MudButton>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="rounded-pill px-4 text-none" Disabled="_isSaving" OnClick="SaveProgressAsync">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ms-n1" />
                <span class="ms-2">Saving...</span>
            }
            else
            {
                <span>Save Progress</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public Guid BookId { get; set; }

    [Parameter]
    public string BookTitle { get; set; } = string.Empty;

    [Parameter]
    public int CurrentPage { get; set; }

    [Parameter]
    public int TotalPages { get; set; }

    private int _currentPage;
    private string? _notes;
    private bool _isSaving = false;

    private double ProgressPercentage => TotalPages > 0 
        ? Math.Min(100.0, Math.Round((double)_currentPage / TotalPages * 100.0, 1)) 
        : 0;

    protected override void OnInitialized()
    {
        _currentPage = CurrentPage;
    }

    private void AddPages(int count)
    {
        var target = _currentPage + count;
        if (target < 0) target = 0;
        if (TotalPages > 0 && target > TotalPages) target = TotalPages;
        _currentPage = target;
    }

    private void MarkFinished()
    {
        if (TotalPages > 0)
        {
            _currentPage = TotalPages;
        }
    }

    private async Task SaveProgressAsync()
    {
        _isSaving = true;
        try
        {
            var updateDto = new UpdateProgressDto(
                CurrentPage: _currentPage,
                Notes: _notes,
                LogDate: DateTime.UtcNow
            );

            await BookService.UpdateProgressAsync(BookId, updateDto);
            Snackbar.Add("Reading session logged!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
